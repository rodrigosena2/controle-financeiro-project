# O padrão recomendado é manter React e API na mesma origem.
# O valor é incorporado durante `npm run build`.
# Copie para .env.local se precisar alterar. Nunca coloque segredos neste arquivo.
# /api acompanha localhost, IPv4 e domínio de produção sem recompilar por host.
# Origens diferentes são recusadas; mantenha UI e API no mesmo servidor/proxy HTTPS.
REACT_APP_API_BASE_URL=/api

# Usado somente por `npm.cmd start`; não é incorporado ao bundle do navegador.
# A aplicação compilada continua usando /api na mesma origem do ASP.NET Core.
CONTROLE_FINANCEIRO_API_PROXY=https://localhost:7091
