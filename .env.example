# Firebase Web configuration. These identifiers are public client configuration,
# not service-account credentials. Copy this file to .env.local for local use and
# configure the same names in Vercel for Preview and Production.
REACT_APP_FIREBASE_API_KEY=your-web-api-key
REACT_APP_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your-project-id
REACT_APP_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
REACT_APP_FIREBASE_APP_ID=your-web-app-id
REACT_APP_FIREBASE_MEASUREMENT_ID=your-measurement-id
